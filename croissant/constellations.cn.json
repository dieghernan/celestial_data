  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "records",
      "name": "records",
      "description": "One record per source feature or CSV row in its original order. No values are imputed. Publication dates describe the collection release, not observations; J2000 is a celestial reference epoch, not a file date. The row-position key is local to this snapshot.",
      "key": {
        "@id": "records/record_index"
      },
      "field": [
        {
          "@type": "cr:Field",
          "@id": "records/record_index",
          "name": "record_index",
          "description": "One-based row position in this source snapshot; unique within this record set, not an astronomical catalog identifier or a persistent cross-release key. Absent properties and JSON null are represented as null; missing values are not imputed.",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "records-json"
            },
            "extract": {
              "jsonPath": "$[*].record_index"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "records/desig",
          "name": "desig",
          "description": "Source designation; its convention depends on the catalog. No catalog prefixes or missing values are inferred. Absent properties and JSON null are represented as null; missing values are not imputed.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "records-json"
            },
            "extract": {
              "jsonPath": "$[*].desig"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "records/display_dec",
          "name": "display_dec",
          "description": "Declination display-center parameter copied from the source; not a new position measurement. Absent properties and JSON null are represented as null; missing values are not imputed.",
          "dataType": "sc:Float",
          "source": {
            "fileObject": {
              "@id": "records-json"
            },
            "extract": {
              "jsonPath": "$[*].display_dec"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "records/display_ra",
          "name": "display_ra",
          "description": "Right-ascension display-center parameter copied from the source; not a new position measurement or a current-epoch prediction. Absent properties and JSON null are represented as null; missing values are not imputed.",
          "dataType": "sc:Float",
          "source": {
            "fileObject": {
              "@id": "records-json"
            },
            "extract": {
              "jsonPath": "$[*].display_ra"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "records/display_scale",
          "name": "display_scale",
          "description": "Source display-scale parameter; not an angular size or a distance. Absent properties and JSON null are represented as null; missing values are not imputed.",
          "dataType": "sc:Float",
          "source": {
            "fileObject": {
              "@id": "records-json"
            },
            "extract": {
              "jsonPath": "$[*].display_scale"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "records/en",
          "name": "en",
          "description": "Source name in English; no translation or normalization is added. Absent properties and JSON null are represented as null; missing values are not imputed.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "records-json"
            },
            "extract": {
              "jsonPath": "$[*].en"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "records/id",
          "name": "id",
          "description": "Identifier as stored in this source catalog, preserving its original text or numeric representation. It is not assumed unique across catalogs or records. Absent properties and JSON null are represented as null; missing values are not imputed.",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "records-json"
            },
            "extract": {
              "jsonPath": "$[*].id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "records/name",
          "name": "name",
          "description": "Name stored in the source; its convention depends on the catalog. Nulls and empty strings are preserved, not filled from another language. Absent properties and JSON null are represented as null; missing values are not imputed.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "records-json"
            },
            "extract": {
              "jsonPath": "$[*].name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "records/pinyin",
          "name": "pinyin",
          "description": "Pinyin transcription provided by the source. Absent properties and JSON null are represented as null; missing values are not imputed.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "records-json"
            },
            "extract": {
              "jsonPath": "$[*].pinyin"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "records/rank",
          "name": "rank",
          "description": "Source display-priority rank, not a physical measurement; its scale depends on the constellation catalog. Absent properties and JSON null are represented as null; missing values are not imputed.",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "records-json"
            },
            "extract": {
              "jsonPath": "$[*].rank"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "records/geometry_wkt",
          "name": "geometry_wkt",
          "description": "Original geometry encoded as WKT without reprojection, rounding or simplification. J2000 celestial angles in degrees: x is right ascension converted from hours at 15 degrees/hour and wrapped to [-180,180]; y is declination. These are not terrestrial WGS84 positions. WKT itself does not carry this reference frame. Absent properties and JSON null are represented as null; missing values are not imputed.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "records-json"
            },
            "extract": {
              "jsonPath": "$[*].geometry_wkt"
            }
          }
        }
      ]
