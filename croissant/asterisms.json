  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "records",
      "name": "records",
      "description": "One record per source feature or CSV row in its original order. No values are imputed. Publication dates describe the collection release, not observations; J2000 is a celestial reference epoch, not a file date. The row-position key is local to this snapshot.",
      "key": {
        "@id": "records/record_index"
      },
      "field": [
        {
          "@type": "cr:Field",
          "@id": "records/record_index",
          "name": "record_index",
          "description": "One-based row position in this source snapshot; unique within this record set, not an astronomical catalog identifier or a persistent cross-release key. Absent properties and JSON null are represented as null; missing values are not imputed.",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "records-json"
            },
            "extract": {
              "jsonPath": "$[*].record_index"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "records/es",
          "name": "es",
          "description": "Source name in Spanish; no translation or normalization is added. Absent properties and JSON null are represented as null; missing values are not imputed.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "records-json"
            },
            "extract": {
              "jsonPath": "$[*].es"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "records/id",
          "name": "id",
          "description": "Identifier as stored in this source catalog, preserving its original text or numeric representation. It is not assumed unique across catalogs or records. Absent properties and JSON null are represented as null; missing values are not imputed.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "records-json"
            },
            "extract": {
              "jsonPath": "$[*].id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "records/loc_lat",
          "name": "loc_lat",
          "description": "Asterism label y position (declination-like angle) in degrees; not terrestrial latitude. Absent properties and JSON null are represented as null; missing values are not imputed.",
          "dataType": "sc:Float",
          "source": {
            "fileObject": {
              "@id": "records-json"
            },
            "extract": {
              "jsonPath": "$[*].loc_lat"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "records/loc_lon",
          "name": "loc_lon",
          "description": "Asterism label x position in the same celestial-angle encoding as the geometry, in degrees; not terrestrial longitude. Absent properties and JSON null are represented as null; missing values are not imputed.",
          "dataType": "sc:Float",
          "source": {
            "fileObject": {
              "@id": "records-json"
            },
            "extract": {
              "jsonPath": "$[*].loc_lon"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "records/n",
          "name": "n",
          "description": "Proper name of the asterism, as supplied by the source. Absent properties and JSON null are represented as null; missing values are not imputed.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "records-json"
            },
            "extract": {
              "jsonPath": "$[*].n"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "records/p",
          "name": "p",
          "description": "Asterism display priority from 1 to 6; 6 denotes a guide line. This is a display parameter, not measured brightness. Absent properties and JSON null are represented as null; missing values are not imputed.",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "records-json"
            },
            "extract": {
              "jsonPath": "$[*].p"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "records/geometry_wkt",
          "name": "geometry_wkt",
          "description": "Original geometry encoded as WKT without reprojection, rounding or simplification. J2000 celestial angles in degrees: x is right ascension converted from hours at 15 degrees/hour and wrapped to [-180,180]; y is declination. These are not terrestrial WGS84 positions. WKT itself does not carry this reference frame. Absent properties and JSON null are represented as null; missing values are not imputed.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "records-json"
            },
            "extract": {
              "jsonPath": "$[*].geometry_wkt"
            }
          }
        }
      ]
    }
  ]
