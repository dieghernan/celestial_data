  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "records",
      "name": "records",
      "description": "One record per source feature or CSV row in its original order. No values are imputed. Publication dates describe the collection release, not observations; J2000 is a celestial reference epoch, not a file date. The row-position key is local to this snapshot.",
      "key": {
        "@id": "records/record_index"
      },
      "field": [
        {
          "@type": "cr:Field",
          "@id": "records/record_index",
          "name": "record_index",
          "description": "One-based row position in this source snapshot; unique within this record set, not an astronomical catalog identifier or a persistent cross-release key. Absent properties and JSON null are represented as null; missing values are not imputed.",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "records-json"
            },
            "extract": {
              "jsonPath": "$[*].record_index"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "records/ids",
          "name": "ids",
          "description": "Border identifier stored in the source; constellation pairs remain a single string, not a normalized relation. Absent properties and JSON null are represented as null; missing values are not imputed.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "records-json"
            },
            "extract": {
              "jsonPath": "$[*].ids"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "records/geometry_wkt",
          "name": "geometry_wkt",
          "description": "Original geometry encoded as WKT without reprojection, rounding or simplification. J2000 celestial angles in degrees: x is right ascension converted from hours at 15 degrees/hour and wrapped to [-180,180]; y is declination. These are not terrestrial WGS84 positions. WKT itself does not carry this reference frame. Absent properties and JSON null are represented as null; missing values are not imputed.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "records-json"
            },
            "extract": {
              "jsonPath": "$[*].geometry_wkt"
            }
          }
        }
      ]
    }
